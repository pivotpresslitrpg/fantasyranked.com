---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookCard from '../components/BookCard.astro';
import PostCard from '../components/PostCard.astro';
import FeaturedAuthors from '../components/FeaturedAuthors.astro';
import { getBooks, getRecentBooks, platformUrl, PLATFORM_NAME } from '../lib/api';
import { rankingConfig } from '../lib/rankings';
import { getCollection } from 'astro:content';

const today = new Date().toISOString().slice(0, 10);
const [topBooks, recentBooks, allPosts] = await Promise.all([
  getBooks({ sort: 'top_rated', limit: 10, source: 'litrpg' }),
  getRecentBooks({ days: 30, limit: 8, source: 'litrpg' }),
  getCollection('posts').catch(() => [])
]);
const latestPosts = allPosts
  .filter(post => post.data.date <= today)
  .sort((a, b) => b.data.date.localeCompare(a.data.date))
  .slice(0, 6);

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Fantasy Ranked",
  "url": "https://fantasyranked.com",
  "description": "Power fantasy and system apocalypse rankings, updated weekly. LitRPG, progression fantasy, cultivation, and isekai."
};

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Fantasy Ranked",
  "url": "https://fantasyranked.com",
  "description": "Power fantasy rankings covering LitRPG, progression fantasy, cultivation, and system apocalypse.",
  "isPartOf": { "@type": "WebSite", "name": "LitRPGTools.com", "url": "https://litrpgtools.com" },
  "knowsAbout": ["Power Fantasy", "LitRPG", "Progression Fantasy", "System Apocalypse", "Isekai", "Cultivation Fiction"]
};
---

<BaseLayout
  title="Fantasy Ranked — Power Fantasy & LitRPG Rankings"
  description="The definitive power fantasy rankings. LitRPG, progression fantasy, system apocalypse, and isekai — ranked by reader ratings and updated weekly."
  schema={[websiteSchema, orgSchema]}
>
  <!-- Hero -->
  <section class="border-b border-[#2e2e2e] py-12 px-4">
    <div class="max-w-5xl mx-auto">
      <p class="text-sm font-semibold text-[#f59e0b] uppercase tracking-wider mb-3">Power Fantasy Rankings</p>
      <h1 class="text-4xl sm:text-5xl font-bold text-white leading-tight max-w-2xl">
        The best power fantasy books, ranked.
      </h1>
      <p class="mt-4 text-lg text-[#888] max-w-xl">
        LitRPG, progression fantasy, system apocalypse, cultivation, and isekai — all in one place. Updated weekly from community ratings.
      </p>
      <div class="flex flex-wrap gap-3 mt-6">
        <a href="/rankings/" class="bg-[#f59e0b] hover:bg-[#d97706] text-black font-semibold px-5 py-2.5 rounded transition-colors">
          Browse Rankings
        </a>
        <a href="/new-releases/" class="border border-[#2e2e2e] hover:border-[#f59e0b]/50 text-[#888] hover:text-white px-5 py-2.5 rounded font-medium transition-colors">
          New Releases
        </a>
      </div>
    </div>
  </section>

  <!-- Platform funnel CTA -->
  <section class="border-b border-[#2e2e2e] bg-gradient-to-r from-[#f59e0b]/10 to-transparent px-4 py-6">
    <div class="max-w-5xl mx-auto flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h2 class="text-lg font-bold text-white">Track your reading on {PLATFORM_NAME}</h2>
        <p class="text-sm text-[#888] mt-1">Thousands of ranked books, a new-release calendar, reviews, and reading-order tools — free.</p>
      </div>
      <a href={platformUrl('home-cta')} target="_blank" rel="noopener" class="shrink-0 bg-[#f59e0b] hover:bg-[#d97706] text-black font-semibold px-5 py-2.5 rounded transition-colors whitespace-nowrap">
        Explore {PLATFORM_NAME} →
      </a>
    </div>
  </section>

  <div class="max-w-5xl mx-auto px-4 py-10 grid grid-cols-1 lg:grid-cols-3 gap-10">

    <!-- Main column -->
    <div class="lg:col-span-2 space-y-12">

      <!-- Latest posts -->
      {latestPosts.length > 0 && (
        <section>
          <div class="flex items-center justify-between mb-5">
            <h2 class="text-xl font-bold text-white">Latest Analysis</h2>
            <a href="/blog/" class="text-sm text-[var(--color-brand)] hover:underline">All posts →</a>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {latestPosts.map(post => (
              <PostCard
                title={post.data.title}
                description={post.data.description}
                slug={post.id.replace(/\.md$/, '')}
                date={post.data.date}
                type={post.data.type}
              />
            ))}
          </div>
        </section>
      )}

      <!-- Recent additions -->
      {recentBooks.length > 0 && (
        <section>
          <div class="flex items-center justify-between mb-5">
            <h2 class="text-xl font-bold text-white">Recent Additions</h2>
            <a href="/new-releases/" class="text-sm text-[#f59e0b] hover:underline">See all →</a>
          </div>
          <div class="bg-[#1a1a1a] border border-[#2e2e2e] rounded-lg px-4">
            {recentBooks.map(book => (
              <BookCard book={book} showDescription={false} />
            ))}
          </div>
        </section>
      )}

      <!-- Genre quick links -->
      <section>
        <h2 class="text-xl font-bold text-white mb-5">Browse by Category</h2>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
          {[
            { label: 'Power Fantasy', href: '/rankings/top-power-fantasy-books/' },
            { label: 'System Apocalypse', href: '/rankings/best-system-apocalypse/' },
            { label: 'Isekai', href: '/rankings/best-isekai-novels/' },
            { label: 'New LitRPG', href: '/rankings/new-litrpg-releases/' },
          ].map(({ label, href }) => (
            <a
              href={href}
              class="bg-[#1a1a1a] border border-[#2e2e2e] hover:border-[#f59e0b]/40 rounded-lg p-4 text-sm font-medium text-[#888] hover:text-white transition-colors"
            >
              {label} →
            </a>
          ))}
        </div>
      </section>
    </div>

    <!-- Sidebar: Top 10 this week -->
    <aside class="space-y-8">
      <section class="bg-[#1a1a1a] border border-[#2e2e2e] rounded-lg p-5">
        <div class="flex items-center justify-between mb-4">
          <h2 class="font-bold text-white">Top Ranked</h2>
          <a href="/rankings/top-power-fantasy-books/" class="text-xs text-[#f59e0b] hover:underline">Full list →</a>
        </div>
        {topBooks.length > 0 ? (
          <div class="divide-y divide-[#2e2e2e]">
            {topBooks.map((book, i) => (
              <BookCard book={book} rank={i + 1} />
            ))}
          </div>
        ) : (
          <p class="text-sm text-[#666] py-4 text-center">Loading rankings…</p>
        )}
      </section>

      <!-- Featured authors → platform author pages -->
      <FeaturedAuthors />
    </aside>
  </div>
</BaseLayout>
